---
import KomponenKad from "~components/KomponenKad.svelte";
import {
  H1Style,
  HrStyle,
  Link,
  LiStyle,
  PreStyle,
  PStyle,
  UlStyle,
  Code,
  OlStyle,
} from "./modular";
import CompilerString from "~components/constants/stringcompiler";
import { getCollection, render } from "astro:content";
import Table from "~components/TableContent.astro";
import Seperator from "~components/stylize/seperator.svelte";
import { Masonry } from "astro-masonry";

const kandungan = await getCollection("kandungan");
const deprecated = await getCollection("deprecated");

const kandunganList = kandungan
  .filter((data) => data.data.order !== undefined && data.data.order >= 1)
  .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity));

const deprecatedList = deprecated.sort(
  (a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity),
);
---

<section>
  <Masonry
    id="bento-container"
    breakpointCols={{
      default: 2,
      500: 1,
    }}
    sortByHeight={true}
    class="flex gap-2 p-6 lg:gap-4 lg:p-12"
  >
    {
      kandunganList.map(async (item) => {
        const { Content } = await render(item);

        return (
          <KomponenKad tajuk={item.data.title}>
            <Content
              components={{
                a: Link,
                h1: H1Style,
                ul: UlStyle,
                li: LiStyle,
                p: PStyle,
                pre: PreStyle,
                hr: HrStyle,
                code: Code,
                ol: OlStyle,
              }}
            />
          </KomponenKad>
        );
      })
    }
  </Masonry>
