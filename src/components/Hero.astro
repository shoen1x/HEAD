---
import HeadLogo from "~assets/brand/headlogo-dark.svg";
import Background from "~assets/background.svg";
import Github from "~assets/github.svg";
import { Picture } from "astro:assets";
import KomponenKad from "~components/KomponenKad.svelte";
import CardDetail from "~components/stylize/card-details.svelte";
import { escapeHTML } from "astro/runtime/server/escape.js";
import { getCollection, render } from "astro:content";
import {
  H1Style,
  HrStyle,
  Link,
  LiStyle,
  PreStyle,
  PStyle,
  UlStyle,
  Code,
  OlStyle,
} from "./modular";

const kHander = await getCollection("kandungan");
const featureContent = kHander.find((data) => data.data.order === 0);
const { Content } = featureContent ? await render(featureContent) : {};
---

<Background class="fixed top-0 left-0 -z-1 h-full w-full blur-3xl" />
<section
  id="container"
  class="relative mx-auto flex flex-1/2 flex-col items-center justify-center gap-2.5 p-6 lg:flex-row lg:gap-4 lg:p-12"
>
  <div
    class="relative flex flex-1/2 flex-col items-center justify-center gap-4 lg:items-start lg:gap-6"
  >
    <div id="head-logo-image-container" class="relative block h-full w-full">
      <HeadLogo id="Head Logo" class="h-auto w-full object-contain lg:w-9/12" />
      <div class="absolute top-0 left-0 h-full w-full"></div>
    </div>
    <div class="flex h-full w-full flex-col gap-4">
      <h1
        class="relative mb-3 inline-block text-2xl font-bold lg:mb-6 lg:text-5xl"
      >
        Panduan ringkas untuk elemen <code>&#60;head&#62;</code> HTML dalam Bahasa
        Melayu.
      </h1>
      <p class="w-full gap-1 text-nowrap">
        Terjemahan dalam <abbr
          title="Malay (بهاس ملايو) is an Austronesian language that is an official language of Brunei, Malaysia, and Singapore."
          >Bahasa Melayu</abbr
        > oleh <a class="font-medium underline" href="https://nmvx.vercel.app/">
          <span>Shoenix</span>
        </a>.
      </p>
      <a href="https://github.com/shoen1x/HEAD" class="w-fit" target="_blank">
        <Github width="32" height="32" />
      </a>
    </div>
  </div>
  <div class="relative flex w-full flex-1/2 items-center justify-center">
    {
      featureContent && Content ? (
        <KomponenKad tajuk={featureContent.data.title}>
          <Content
            components={{
              a: Link,
              h1: H1Style,
              ul: UlStyle,
              li: LiStyle,
              p: PStyle,
              pre: PreStyle,
              hr: HrStyle,
              code: Code,
              ol: OlStyle,
            }}
          />
        </KomponenKad>
      ) : (
        <p>No post found with order = 0.</p>
      )
    }
  </div>
</section>
