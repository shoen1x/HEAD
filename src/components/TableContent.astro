---
import PStyle from "~components/modular/p.svelte";
import PreStyle from "~components/modular/pre.svelte";
import UlStyle from "~components/modular/ul.svelte";
import LiStyle from "~components/modular/li.svelte";
---

<div class="relative bottom-0 left-0 z-10 block lg:fixed">
  <div
    class="relative inset-px h-full max-h-[50vh] w-full max-w-(--breakpoint-md) overflow-y-scroll rounded-lg bg-white lg:m-4 lg:flex-1"
  >
    <div class="relative px-8 pt-4 pb-3 sm:px-10 sm:pt-6 sm:pb-0">
      <p
        class="text-2xl font-bold tracking-tight text-gray-950 max-lg:text-center lg:text-4xl"
      >
        Kandungan
      </p>
    </div>
    <div
      class="relative flex h-full w-full flex-col rounded-[calc(var(--radius-lg)+1px)] p-2"
    >
      <!-- <Content components={{
            p: PStyle,
            pre: PreStyle,
            ul: UlStyle,
            li: LiStyle
        }}/> -->
    </div>
  </div>
</div>
